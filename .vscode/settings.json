{
  // Format code automatically on save
  "editor.formatOnSave": true,
  // Show a ruler at 100 characters
  "editor.rulers": [100],

  // Use Prettier as the default formatter for the following languages:
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  // Configure Tailwind CSS IntelliSense
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "tailwindCSS.classAttributes": ["class", "className", "ngClass", "ngObject"],

  // Disable path suggestions for JavaScript and TypeScript (using Path Intellisense extension)
  "js/ts.suggest.paths": false
}
