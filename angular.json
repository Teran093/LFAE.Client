{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "pnpm",
    "schematicCollections": ["angular-eslint"]
  },
  "newProjectRoot": "projects",
  "projects": {
    "LFAE.Client": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:class": {
          "path": "src/app/core/models",
          "skipTests": true
        },
        "@schematics/angular:interface": {
          "path": "src/app/core/models"
        },
        "@schematics/angular:component": {
          "path": "src/app/shared/components",
          "skipTests": true
        },
        "@schematics/angular:directive": {
          "type": "directive",
          "path": "src/app/shared/directives",
          "skipTests": true
        },
        "@schematics/angular:pipe": {
          "path": "src/app/shared/pipes",
          "typeSeparator": ".",
          "skipTests": true
        },
        "@schematics/angular:service": {
          "path": "src/app/core/services",
          "type": "service",
          "skipTests": true
        },
        "@schematics/angular:guard": {
          "path": "src/app/core/guards",
          "typeSeparator": ".",
          "skipTests": true
        },
        "@schematics/angular:interceptor": {
          "path": "src/app/core/interceptors",
          "typeSeparator": ".",
          "skipTests": true
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": ["src/styles.css"],
            "server": "src/main.server.ts",
            "outputMode": "server",
            "security": {
              "allowedHosts": []
            },
            "ssr": {
              "entry": "src/server.ts"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "LFAE.Client:build:production"
            },
            "development": {
              "buildTarget": "LFAE.Client:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["src/**/*.ts", "src/**/*.html"]
          }
        }
      }
    }
  }
}
